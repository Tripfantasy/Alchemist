  "instrument_bundles": {
    "_comment": [
      "Per-channel / per-frame instrument output. These formats write one file",
      "per channel, tile, or frame, so a single recording session yields dozens",
      "to hundreds of near-identical files. Indexing them individually buries",
      "real results and inflates the 'unknown' tier with machine output.",
      "",
      "When a directory holds at least `threshold` files of a given extension,",
      "build_index.py collapses them into ONE session-level record carrying the",
      "file count and total size. Thresholds are calibrated from the observed",
      "per-directory distribution on this collection -- .tif and .jpg are set",
      "high because small sets of those are usually figures, not session data.",
      "",
      "v6: .svg added -- a single Xenium output bundle writes 1,265 per-cluster",
      "enrichment SVGs (category_network_plot, top_terms_barplot), which otherwise",
      "swamp the real matrices in the same directory."
    ],
    "thresholds": {
      ".ncs": 4,
      ".nse": 4,
      ".ntt": 4,
      ".nev": 4,
      ".nvt": 4,
      ".oir": 8,
      ".dcm": 20,
      ".tif": 50,
      ".tiff": 50,
      ".jpg": 50,
      ".jpeg": 50,
      ".png": 50,
      ".svg": 50
    },
    "labels": {
      ".ncs": "Neuralynx continuous-channel recording session",
      ".nse": "Neuralynx spike-channel recording session",
      ".ntt": "Neuralynx tetrode recording session",
      ".nev": "Neuralynx event file",
      ".nvt": "Neuralynx video-tracking session",
      ".oir": "Olympus OIR imaging session",
      ".dcm": "DICOM image series",
      ".tif": "TIFF image series",
      ".tiff": "TIFF image series",
      ".jpg": "JPEG image series",
      ".jpeg": "JPEG image series",
      ".png": "PNG image series",
      ".svg": "SVG figure series"
    }
  },
  "non_data_extensions": {
    "_comment": [
      "Presentations, documents, system junk and design files. These reach the",
      "'unknown' tier unless a vocabulary term appears in the FILENAME itself,",
      "because otherwise every .pptx under a biologically-named folder is",
      "reported as that biology."
    ],
